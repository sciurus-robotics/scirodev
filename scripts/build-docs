#!/usr/bin/env bash
# Build the sciro API reference (Sphinx) into docs/_build/html.
# Uses the virtual environment found by scripts/env.sh and installs what is
# missing there (this package, Sphinx, furo).
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/env.sh
python -m sphinx -b html -W --keep-going docs docs/_build/html "$@"
echo "docs -> $(pwd)/docs/_build/html"
