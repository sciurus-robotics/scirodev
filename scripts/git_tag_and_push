#!/usr/bin/env bash
# Tag the current commit with the version from pyproject.toml and push the tag.
# The GitHub workflow (.github/workflows/publish.yml) then builds and publishes
# that version to PyPI via Trusted Publishing.
#
# Usage: scripts/git_tag_and_push [remote]     (default remote: origin)
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
remote="${1:-origin}"

version="$(python3 -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')"
tag="v${version}"

if [ -n "$(git status --porcelain)" ]; then
  echo "error: working tree is not clean; commit or stash first" >&2
  exit 1
fi
if git rev-parse -q --verify "refs/tags/${tag}" >/dev/null; then
  echo "error: tag ${tag} already exists (bump the version in pyproject.toml)" >&2
  exit 1
fi
if ! git merge-base --is-ancestor HEAD "${remote}/main" 2>/dev/null; then
  echo "note: HEAD is not on ${remote}/main yet; pushing the branch first"
  git push "${remote}" HEAD
fi

git tag -a "${tag}" -m "scirodev ${version}"
git push "${remote}" "${tag}"
echo "tagged and pushed ${tag}; the publish workflow releases it to PyPI"
